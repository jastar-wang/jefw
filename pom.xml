<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>pom</packaging>

    <groupId>com.jastarwang</groupId>
    <artifactId>jefw</artifactId>
    <version>1.3.3</version>
    <name>jefw</name>
    <description>JastarWang Easy Framework</description>
    <url>https://gitee.com/jastar-wang/jefw</url>

    <modules>
        <module>jefw-all</module>
        <module>jefw-core</module>
        <module>jefw-oss</module>
        <module>jefw-redis</module>
        <module>jefw-sms</module>
        <module>jefw-util</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>utf-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>utf-8</project.reporting.outputEncoding>
        <compile.version>17</compile.version>
        <java.version>17</java.version>
        <!-- common -->
        <lombok.version>1.18.34</lombok.version>
        <jackson.version>2.14.3</jackson.version>
        <spring-boot.version>3.4.3</spring-boot.version>
        <!-- oss module -->
        <aliyun.sdk.oss.version>3.18.1</aliyun.sdk.oss.version>
        <tencent.sdk.cos.version>5.6.244</tencent.sdk.cos.version>
        <!-- sms module -->
        <tencent.cloud.sdk.version>3.1.1179</tencent.cloud.sdk.version>
        <!-- redis module -->
        <redisson.version>3.36.0</redisson.version>
        <!-- util module -->
        <hutool.version>5.8.36</hutool.version>
        <servlet-api.version>6.1.0</servlet-api.version>
    </properties>

    <dependencies>

        <!-- lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- spring boot test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>${spring-boot.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- jackson-databind：提供单元测试环境下SpringBoot可以自动映射properties到bean的支持 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>${compile.version}</source>
                    <target>${compile.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.2.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
                <!-- 附加配置：关闭JavaDoc的检查 -->
                <configuration>
                    <additionalOptions>
                        <additionalOption>${javadoc.opts}</additionalOption>
                    </additionalOptions>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.0.0-M5</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 在jdk1.8+环境下启用该参数 -->
        <profile>
            <id>disable-javadoc-doclint</id>
            <activation>
                <jdk>[1.8,)</jdk>
            </activation>
            <properties>
                <javadoc.opts>-Xdoclint:none</javadoc.opts>
            </properties>
        </profile>
    </profiles>
</project>