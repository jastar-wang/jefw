<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>
    <parent>
        <artifactId>jefw</artifactId>
        <groupId>com.jastar-wang</groupId>
        <version>2.5.1</version>
    </parent>
    <artifactId>jefw-redis</artifactId>
    <name>${project.artifactId}</name>
    <description>Redis模块：提供缓存工具类以及分布式锁的封装支持</description>

    <dependencies>

        <!-- jefw core -->
        <dependency>
            <groupId>com.jastar-wang</groupId>
            <artifactId>jefw-core</artifactId>
            <version>${project.parent.version}</version>
        </dependency>

        <!-- spring data redis starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <version>${spring-boot.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- redisson（不使用分布式锁时，可以不提供） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <version>${redisson.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- 默认 Redis 缓存序列化使用 Jackson，显式覆盖父 POM 对 databind 的 test 作用域 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>compile</scope>
        </dependency>

        <!-- jackson-databind: 支持Java8的时间反/序列化 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- jackson-databind: 支持Java8的新类型 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jdk8</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <!-- jackson-databind: 支持访问构造函数和方法参数名称 -->
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-parameter-names</artifactId>
            <version>${jackson.version}</version>
        </dependency>

    </dependencies>

</project>